{
  "realm": "lawfirm",
  "displayName": "Công ty luật (IdP của khách)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "groups": [
    {"name": "legal", "path": "/legal"},
    {"name": "finance", "path": "/finance"},
    {"name": "it", "path": "/it"}
  ],
  "clients": [
    {
      "clientId": "quillo",
      "name": "Quillo",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${FDE_QUILLO_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
      "webOrigins": ["+"],
      "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+"},
      "protocolMappers": [
        {
          "name": "quillo-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "quillo",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "an",
      "enabled": true,
      "email": "an@lawfirm.test",
      "emailVerified": true,
      "firstName": "An",
      "lastName": "Nguyễn",
      "credentials": [{"type": "password", "value": "an-lab-only-pw", "temporary": false}],
      "groups": ["/legal"]
    },
    {
      "username": "binh",
      "enabled": true,
      "email": "binh@lawfirm.test",
      "emailVerified": true,
      "firstName": "Bình",
      "lastName": "Trần",
      "credentials": [{"type": "password", "value": "binh-lab-only-pw", "temporary": false}],
      "groups": ["/finance"]
    },
    {
      "username": "chi",
      "enabled": true,
      "email": "chi@lawfirm.test",
      "emailVerified": true,
      "firstName": "Chi",
      "lastName": "Lê",
      "credentials": [{"type": "password", "value": "chi-lab-only-pw", "temporary": false}],
      "groups": ["/legal", "/finance"]
    }
  ]
}
