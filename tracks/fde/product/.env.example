# Sao thành .env rồi điền. Không commit .env.
# Bản quillo-api đã nạp (docker images quillo-api).
QUILLO_VERSION=1.1.0
# Token quản trị cho API và UI, tối thiểu 16 ký tự. Sinh: openssl rand -hex 24
QUILLO_ADMIN_TOKEN=
# Mật khẩu Postgres, chỉ dùng chữ và số (nằm trong URL kết nối). Sinh: openssl rand -hex 24
QUILLO_DB_PASSWORD=
# Địa chỉ và cổng phía host của api. Mặc định chỉ máy này truy cập được (127.0.0.1).
QUILLO_BIND=127.0.0.1
QUILLO_PORT=18080
QUILLO_MAX_UPLOAD_MB=20
# Model chat trong ./models (mặc định Qwen2.5-0.5B-Instruct Q4_K_M) và số luồng CPU cho llm/embed.
QUILLO_LLM_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
QUILLO_LLM_MODEL=llm-small
QUILLO_LLM_THREADS=2
QUILLO_EMBED_THREADS=2
