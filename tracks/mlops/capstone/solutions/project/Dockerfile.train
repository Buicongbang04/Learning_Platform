FROM python:3.12.11-slim AS deps
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
COPY requirements-train.txt /tmp/requirements.txt
RUN /opt/venv/bin/pip install --only-binary=:all: -r /tmp/requirements.txt

FROM python:3.12.11-slim
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MLFLOW_DISABLE_AGENT_HINT=1
RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin eta
COPY --from=deps /opt/venv /opt/venv
WORKDIR /app
COPY src/ /app/src/
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT
COPY params.yaml /app/params.yaml
ENV ETA_DATA_DIR=/data
ENTRYPOINT ["python", "-m", "eta.cli"]
CMD ["train", "--config", "/app/params.yaml"]
USER 10001
