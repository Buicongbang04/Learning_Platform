--- a/nginx/olist-shop.conf   (production, trước 14:02)
+++ b/nginx/olist-shop.conf   (CHG-3107, sao từ staging)
@@ upstream olist_api @@
 upstream olist_api {
-    server api-1.internal:8000 max_fails=3 fail_timeout=30s;
-    server api-2.internal:8000 max_fails=3 fail_timeout=30s;
+    server api-1.internal:8080 max_fails=3 fail_timeout=30s;
+    server api-2.internal:8080 max_fails=3 fail_timeout=30s;
 }
@@ server shop.olist-shop.com.br @@
     location = /healthz {
-        proxy_pass http://olist_api/healthz;
+        access_log off;
+        default_type text/plain;
+        return 200 "ok\n";
     }

-    location / {
-        proxy_pass http://olist_api;
-    }
+    location / {
+        try_files $uri $uri/ /index.html;
+    }
+
+    location /api/ {
+        proxy_pass http://olist_api;
+        proxy_set_header Host $host;
+        proxy_set_header X-Forwarded-For $remote_addr;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_set_header X-Request-ID $request_id;
+    }

# Ghi chú trong PR: "staging chạy API trên 8080 từ tháng 9 (image mới), prod vẫn 8000 vì chưa đổi image"
# Ghi chú trong PR: "healthz trả thẳng từ Nginx cho nhẹ, LB gọi 5 giây một lần"
