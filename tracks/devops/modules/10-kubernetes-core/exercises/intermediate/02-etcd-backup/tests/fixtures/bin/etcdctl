#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
with open(os.environ["FAKE_CALLS"], "a", encoding="utf-8") as log:
    env = {k: v for k, v in os.environ.items() if k.startswith("ETCDCTL_")}
    log.write(json.dumps({"tool": "etcdctl", "args": args, "env": env}) + "\n")
if "snapshot" in args and "save" in args:
    target = Path(args[args.index("save") + 1])
    part = target.with_name(target.name + ".part")
    part.write_bytes(b"\0" * 4096)
    if os.environ.get("FAKE_ETCDCTL_FAIL") == "1":
        print("Error: context deadline exceeded", file=sys.stderr)
        sys.exit(1)
    part.rename(target)
    print(f"Snapshot saved at {target}")
    sys.exit(0)
print("etcdctl giả chỉ hỗ trợ snapshot save", file=sys.stderr)
sys.exit(2)
