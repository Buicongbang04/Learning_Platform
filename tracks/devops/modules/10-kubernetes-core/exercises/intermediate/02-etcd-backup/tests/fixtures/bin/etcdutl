#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
with open(os.environ["FAKE_CALLS"], "a", encoding="utf-8") as log:
    log.write(json.dumps({"tool": "etcdutl", "args": args, "env": {}}) + "\n")
if args[:2] == ["snapshot", "status"] and len(args) >= 3:
    if os.environ.get("FAKE_ETCDUTL_FAIL") == "1" or not Path(args[2]).is_file():
        print("Error: snapshot file has wrong size or is corrupted", file=sys.stderr)
        sys.exit(1)
    keys = int(os.environ.get("FAKE_TOTAL_KEYS", "1234"))
    if "json" in " ".join(args[3:]):
        print(json.dumps({"hash": 3966563442, "revision": 5120, "totalKey": keys, "totalSize": 4096, "version": "3.6.0"}))
    else:
        print(f"3966563442, 5120, {keys}, 4.1 kB, 3.6.0")
    sys.exit(0)
print("etcdutl giả chỉ hỗ trợ snapshot status", file=sys.stderr)
sys.exit(2)
